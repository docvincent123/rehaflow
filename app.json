{
  "expo": {
    "name": "RehaFlow",
    "slug": "rehaflow",
    "version": "1.6.21",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "rehaflow",
    "newArchEnabled": true,
    "runtimeVersion": "1.6.21",
    "assetBundlePatterns": ["**/*"],
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#10141E"
    },
    "android": {
      "package": "com.rehaflow.mobile",
      "versionCode": 1621,
      "permissions": ["INTERNET", "ACCESS_NETWORK_STATE", "POST_NOTIFICATIONS", "VIBRATE"]
    },
    "ios": {
      "bundleIdentifier": "com.rehaflow.mobile",
      "supportsTablet": true,
      "infoPlist": {"ITSAppUsesNonExemptEncryption": false}
    },
    "web": {"bundler": "metro", "output": "single"},
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-updates",
      ["expo-notifications", {"color": "#1E88E5"}]
    ],
    "experiments": {"typedRoutes": true, "reactCompiler": true}
  }
}
